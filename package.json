{
  "name": "my-ai-portfolio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "verify:content": "node scripts/verify-public-content.mjs",
    "verify:profile": "node --no-warnings --experimental-strip-types scripts/verify-profile-data.mjs",
    "verify:chat": "node --no-warnings --experimental-strip-types scripts/verify-chat-contract.mjs",
    "verify:resume": "node --no-warnings --experimental-strip-types scripts/verify-public-resume.mjs",
    "verify:deploy": "node scripts/verify-deploy-readiness.mjs",
    "verify": "npm run verify:content && npm run verify:profile && npm run verify:chat && npm run verify:resume && npm run lint && npm run typecheck && npm run build",
    "verify:all": "npm run verify:content && npm run verify:profile && npm run verify:chat && npm run verify:resume && npm run lint && npm run typecheck && npm run build && npm run verify:deploy"
  },
  "dependencies": {
    "@vercel/kv": "^3.0.0",
    "gray-matter": "^4.0.3",
    "katex": "^0.16.28",
    "lucide-react": "^0.575.0",
    "next": "16.1.6",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/katex": "^0.16.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
