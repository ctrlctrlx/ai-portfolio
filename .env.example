# Confirmed public production origin. Overrides must remain origin-only HTTPS URLs.
NEXT_PUBLIC_SITE_URL=https://ctrlctrlx.top

# Optional Vercel KV settings for visitor counts and chat rate limiting.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional DeepSeek API key for the career assistant's fallback answer layer.
# Server-side only — never prefix with NEXT_PUBLIC_ and never commit a real key.
# When empty, the assistant runs in rule-engine-only mode (no external calls).
DEEPSEEK_API_KEY=
